NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
DATABASE_URL=mysql://user:password@localhost:3306/sheshape
JWT_SECRET=
JWT_EXPIRES_DAYS=7
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=sheshape-media
S3_PUBLIC_URL=https://she-upgrade.s3.eu-north-1.amazonaws.com

# Public site URL, used in email links.
CLIENT_URL=https://sheshapewellness.com

# Encrypts admin-entered secrets (Stripe keys) at rest. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# DB-seeded admin account (created automatically on server boot if both are set)
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=0788000000

# SMTP (cPanel mail) — leave SMTP_HOST blank in development to print OTP emails to the console instead
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=She Shape
MAIL_FROM_EMAIL=no-reply@sheshape.com

# Logo shown in the header of branded emails. Optional — defaults to the
# white-on-transparent logo already hosted on S3 (see
# src/scripts/uploadEmailLogo.js). Only set this if you want to swap it.
EMAIL_LOGO_URL=

# Error reporting (optional). Leave blank to disable; nothing is loaded without it.
SENTRY_DSN=

# Requests allowed per IP before a 429: auth routes per 15 minutes, contact form per hour.
AUTH_RATE_LIMIT_MAX=20
CONTACT_RATE_LIMIT_MAX=5

# Brevo (transactional email + newsletter list). The API key avoids SMTP port
# blocks on shared hosting. BREVO_LIST_ID is the numeric id of the newsletter list.
BREVO_API_KEY=
BREVO_LIST_ID=

# XentriPay. The API key and webhook secret are entered by the admin under
# Payment settings. Base URLs follow the integration pack; override only if
# XentriPay tells you to.
XENTRIPAY_LIVE_URL=https://xentripay.com
XENTRIPAY_SANDBOX_URL=https://merchant.test.xentripay.com

# Rate limits for the other public forms (requests per IP per hour).
NEWSLETTER_RATE_LIMIT_MAX=10
BOOKING_RATE_LIMIT_MAX=6
