# Used by `npm test`. Points at a throwaway database that tests wipe on every run.
NODE_ENV=test
PORT=0
CLIENT_URL=http://localhost:5173
DATABASE_URL=mysql://sheshape:sheshape@127.0.0.1:3306/sheshape_test
JWT_SECRET=test-only-secret-do-not-use-in-production
JWT_EXPIRES_DAYS=7
AWS_REGION=eu-central-1
S3_BUCKET=sheshape-test
S3_PUBLIC_URL=https://sheshape-test.example.com
ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
ADMIN_EMAIL=admin-inbox@example.com
AUTH_RATE_LIMIT_MAX=30
CONTACT_RATE_LIMIT_MAX=3
NEWSLETTER_RATE_LIMIT_MAX=20
BOOKING_RATE_LIMIT_MAX=20
ORDER_RATE_LIMIT_MAX=500
PAYMENT_STATUS_RATE_LIMIT_MAX=1000
UPLOADS_DIR=/tmp/sheshape-test-uploads
