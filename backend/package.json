{
  "name": "sheshape-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node --env-file=.env src/server.js",
    "db:sync": "node --env-file=.env src/scripts/sync.js",
    "db:seed": "node --env-file=.env src/scripts/seed.js",
    "make:admin": "node --env-file=.env src/scripts/createAdmin.js",
    "seed:admin": "node --env-file=.env src/scripts/seedAdmin.js",
    "seed:programs": "node --env-file=.env src/scripts/seedPrograms.js",
    "test": "node --env-file=.env.test --test --test-concurrency=1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1125.0",
    "@aws-sdk/s3-request-presigner": "^3.1125.0",
    "@sentry/node": "^11.7.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.0",
    "mysql2": "^3.24.3",
    "nodemailer": "^10.1.1",
    "sequelize": "^6.37.8",
    "slugify": "^1.6.9"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
